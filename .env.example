# Copy to .env for local Docker Compose. Never commit .env.
# Staging and production values live in the provider's secret store
# (Google Secret Manager for Cloud Run, `wrangler secret` for the Worker, GitHub Actions secrets for CI).

# ── PostgreSQL (local Docker only) ──
POSTGRES_DB=lupin
POSTGRES_USER=lupin
POSTGRES_PASSWORD=change-me-locally

# ── Backend ──
SPRING_PROFILES_ACTIVE=local
DATABASE_URL=jdbc:postgresql://localhost:5432/lupin
DATABASE_USERNAME=lupin
DATABASE_PASSWORD=change-me-locally
# Base64 of at least 32 random bytes:  openssl rand -base64 48
LUPIN_JWT_SECRET=
# Comma-separated browser origins allowed to call the API directly (local dev only; production is same-origin).
LUPIN_ALLOWED_ORIGINS=http://localhost:5173
# First owner account. Set both, start once, then remove them.
LUPIN_BOOTSTRAP_OWNER_EMAIL=
LUPIN_BOOTSTRAP_OWNER_PASSWORD=

# Shared key between the storefront Worker and the API (the Worker's EDGE_SHARED_SECRET must be the same
# value). Leave empty locally. Staging and production refuse to start without one of 32+ characters:
#   openssl rand -base64 48
LUPIN_EDGE_SECRET=

# Public address of the storefront (Paymob redirect + webhook addresses are built from it).
LUPIN_PUBLIC_BASE_URL=http://localhost:5173

# ── Paymob (leave empty to keep online payments off). Enter real values in the secret store, never here. ──
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PAYMOB_INTEGRATION_ID_FAWRY=

# ── Bosta courier (leave empty to keep it off). Real values go in the secret store, never here. ──
# API key from Bosta's dashboard (Read/Write). Webhook secret: 24+ random characters, e.g. openssl rand -base64 32
BOSTA_API_KEY=
BOSTA_WEBHOOK_SECRET=
# BOSTA_BASE_URL=https://app.bosta.co/api/v2
# BOSTA_BUSINESS_LOCATION_ID=
# BOSTA_PACKAGE_TYPE=Small

# ── Not wired yet (integration boundaries only) ──
# CLOUDINARY_CLOUD_NAME=     CLOUDINARY_API_KEY=         CLOUDINARY_API_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=    GOOGLE_OAUTH_CLIENT_SECRET=
# SMS_PROVIDER_API_KEY=      MAIL_API_KEY=

# ── Frontend Worker (frontend/.dev.vars locally, wrangler vars in the cloud) ──
# API_ORIGIN=http://localhost:8080
