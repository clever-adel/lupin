{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lupin-storefront-production",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Where the Worker forwards /api/* and fetches data during server rendering.
  // Local default; staging and production override it below (set the real Cloud Run URLs at deploy time).
  "vars": {
    "API_ORIGIN": "http://localhost:8080",
    "SITE_ORIGIN": "http://localhost:5173"
  },
  "r2_buckets": [
    { "binding": "MEDIA_BUCKET", "bucket_name": "lupin-product-images" }
  ],
  "env": {
    // Browser tests: a second local copy on its own ports (CLOUDFLARE_ENV=e2e), so tests never use
    // the database you are looking at on :5173.
    "e2e": {
      "vars": { "API_ORIGIN": "http://localhost:8090", "SITE_ORIGIN": "http://localhost:5183" }
    },
    "staging": {
      "vars": { "API_ORIGIN": "https://REPLACE-WITH-STAGING-CLOUD-RUN-URL", "SITE_ORIGIN": "https://staging.lupinwear.store" }
    },
    // Named explicitly: without "name", Wrangler deploys to "<top-level name>-production", a second,
    // empty Worker. Bindings such as R2 are not inherited by environments, so the bucket is repeated.
    "production": {
      "name": "lupin-storefront-production",
      "vars": { "API_ORIGIN": "https://lupin-api-racc.onrender.com", "SITE_ORIGIN": "https://lupinwear.store" },
      "r2_buckets": [
        { "binding": "MEDIA_BUCKET", "bucket_name": "lupin-product-images" }
      ]
    }
  }
}
